:root {
    --mint: #dff3ec;
    --mint-dark: #8fc9b7;
    --black: #171717;
    --gray: #777;
    --light-gray: #f7f7f7;
    --border: #e8e8e8;
    --white: #fff;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #fff;
    color: var(--black);
    font-family: Tahoma, Arial, sans-serif;
}

/* =========================
   Header
========================= */

.site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
}

.header-inner {
    max-width: 1400px;
    min-height: 76px;
    margin: auto;
    padding: 0 28px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.logo {
    color: var(--black);
    text-decoration: none;
    font-size: 25px;
    font-weight: 800;
    white-space: nowrap;
}

.main-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    flex: 1;
}

.main-nav a {
    color: #333;
    text-decoration: none;
    font-size: 14px;
    transition: 0.2s ease;
}

.main-nav a:hover {
    color: #579b85;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 18px;
}

.header-actions a {
    color: #222;
    text-decoration: none;
    font-size: 14px;
}

.cart-link {
    position: relative;
}

/* =========================
   Hero
========================= */

.hero {
    max-width: 1400px;
    min-height: 470px;
    margin: 28px auto 70px;
    padding: 70px 80px;

    border-radius: 30px;

    background:
        radial-gradient(
            circle at 85% 20%,
            rgba(255, 255, 255, 0.8),
            transparent 28%
        ),
        linear-gradient(135deg, #edf9f5, #dcefe9);

    display: flex;
    align-items: center;
}

.hero-content {
    max-width: 720px;
}

.hero-small {
    margin-bottom: 18px;
    color: #579b85;
    font-size: 14px;
    font-weight: 700;
}

.hero h1 {
    margin: 0;
    font-size: clamp(34px, 4vw, 58px);
    line-height: 1.5;
    letter-spacing: -1px;
}

.hero p {
    margin: 25px 0 32px;
    color: #666;
    font-size: 17px;
    line-height: 2;
}

.hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 180px;
    padding: 15px 28px;

    border-radius: 12px;

    background: var(--black);
    color: #fff;

    text-decoration: none;
    font-size: 14px;

    transition: 0.25s ease;
}

.hero-button:hover {
    transform: translateY(-2px);
    background: #333;
}

/* =========================
   Sections
========================= */

.home-section {
    max-width: 1400px;
    margin: 0 auto 80px;
    padding: 0 28px;
}

.section-heading {
    margin-bottom: 28px;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
}

.section-heading h2 {
    margin: 0;
    font-size: 27px;
    font-weight: 800;
}

.section-heading span {
    color: var(--gray);
    font-size: 14px;
}

/* =========================
   Categories
========================= */

.categories-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
}

.category-card {
    min-height: 150px;
    padding: 25px;

    border: 1px solid var(--border);
    border-radius: 18px;

    background: #fff;

    display: flex;
    align-items: flex-end;

    cursor: pointer;

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease,
        border-color 0.25s ease;
}

.category-card:hover {
    transform: translateY(-5px);
    border-color: #c9e4db;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.07);
}

.category-card h3 {
    margin: 0 0 8px;
    font-size: 17px;
}

.category-count {
    color: #888;
    font-size: 13px;
}

/* =========================
   Products
========================= */

.products-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
}

.product-card {
    position: relative;
    overflow: hidden;

    border: 1px solid var(--border);
    border-radius: 18px;

    background: #fff;

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease,
        border-color 0.25s ease;
}

.product-card:hover {
    transform: translateY(-5px);
    border-color: #d9d9d9;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);
}

.product-image-wrapper {
    height: 290px;
    padding: 18px;

    background: #fafafa;

    display: flex;
    align-items: center;
    justify-content: center;
}

.product-image {
    width: 100%;
    height: 100%;

    object-fit: contain;

    transition: transform 0.3s ease;
}

.product-card:hover .product-image {
    transform: scale(1.04);
}

.product-image-placeholder {
    color: #aaa;
    font-size: 13px;
}

.product-info {
    padding: 18px 18px 20px;
}

.product-brand {
    margin-bottom: 8px;
    color: #8b8b8b;
    font-size: 12px;
}

.product-name {
    display: block;
    min-height: 44px;

    color: #222;
    text-decoration: none;

    font-size: 14px;
    line-height: 1.8;
}

.product-price {
    margin-top: 14px;
    font-size: 15px;
    font-weight: 800;
}

.product-status {
    margin-top: 8px;
    color: #579b85;
    font-size: 12px;
}

.add-cart {
    position: absolute;
    left: 15px;
    bottom: 15px;

    width: 34px;
    height: 34px;

    border: 0;
    border-radius: 50%;

    background: var(--black);
    color: #fff;

    font-size: 21px;
    line-height: 34px;

    cursor: pointer;

    transition: 0.2s ease;
}

.add-cart:hover {
    transform: scale(1.08);
    background: #579b85;
}

/* =========================
   Brands
========================= */

.brands-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 12px;
}

.brand-card {
    min-height: 90px;
    padding: 18px;

    border: 1px solid var(--border);
    border-radius: 15px;

    background: #fff;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    font-size: 13px;
    font-weight: 700;

    transition: 0.25s ease;
}

.brand-card:hover {
    background: var(--mint);
    border-color: #c9e4db;
    transform: translateY(-3px);
}

/* =========================
   Loading
========================= */

.loading {
    width: 100%;
    padding: 45px 20px;

    border: 1px dashed #ddd;
    border-radius: 15px;

    color: #888;
    text-align: center;
}

/* =========================
   Footer
========================= */

.site-footer {
    margin-top: 100px;
    padding: 55px 28px;

    background: #171717;
    color: #fff;
}

.footer-inner {
    max-width: 1400px;
    margin: auto;

    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
}

.footer-about {
    max-width: 500px;
}

.footer-about h3 {
    margin: 0 0 15px;
    font-size: 22px;
}

.footer-about p {
    margin: 0;
    color: #bbb;
    font-size: 13px;
    line-height: 2;
}

.footer-links {
    display: flex;
    gap: 25px;
}

.footer-links a {
    color: #ccc;
    text-decoration: none;
    font-size: 13px;
}

.footer-links a:hover {
    color: #fff;
}

/* =========================
   Tablet
========================= */

@media (max-width: 1100px) {

    .header-inner {
        padding: 0 20px;
    }

    .main-nav {
        gap: 18px;
    }

    .hero {
        margin-left: 20px;
        margin-right: 20px;
        padding: 55px;
    }

    .home-section {
        padding: 0 20px;
    }

    .categories-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .products-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .brands-grid {
        grid-template-columns: repeat(4, 1fr);
    }
}

/* =========================
   Mobile
========================= */

@media (max-width: 750px) {

    .header-inner {
        min-height: 65px;
        padding: 0 15px;
    }

    .main-nav {
        display: none;
    }

    .logo {
        font-size: 21px;
    }

    .header-actions {
        gap: 12px;
    }

    .header-actions a {
        font-size: 12px;
    }

    .hero {
        min-height: 410px;
        margin: 15px 15px 55px;
        padding: 40px 25px;
        border-radius: 22px;
    }

    .hero h1 {
        font-size: 31px;
        line-height: 1.6;
    }

    .hero p {
        font-size: 14px;
    }

    .home-section {
        margin-bottom: 60px;
        padding: 0 15px;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
        gap: 8px;
    }

    .section-heading h2 {
        font-size: 23px;
    }

    .categories-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .category-card {
        min-height: 125px;
        padding: 18px;
    }

    .products-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .product-image-wrapper {
        height: 220px;
        padding: 12px;
    }

    .product-info {
        padding: 14px;
    }

    .product-name {
        font-size: 12px;
    }

    .product-price {
        font-size: 13px;
    }

    .add-cart {
        left: 10px;
        bottom: 10px;

        width: 30px;
        height: 30px;

        line-height: 30px;
        font-size: 18px;
    }

    .brands-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .footer-inner {
        flex-direction: column;
    }

    .footer-links {
        flex-wrap: wrap;
    }
}

@media (max-width: 450px) {

    .categories-grid,
    .products-grid {
        grid-template-columns: 1fr;
    }

    .product-image-wrapper {
        height: 270px;
    }

    .hero h1 {
        font-size: 27px;
    }
}
